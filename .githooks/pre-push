#!/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -ExecutionPolicy Bypass
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# Mirrors the "Static checks (required)" job in .github/workflows/ci.yml.
# scripts/run-checks.ps1 was removed on 2026-08-14 when the Python backend
# moved to s-shahzad/portfolio-backend; it only drove the API smoke tests.

$repoRoot = Split-Path -Parent $PSScriptRoot
Push-Location $repoRoot
try {
    node --check script.js
    if ($LASTEXITCODE -ne 0) { Write-Error 'JS syntax check failed'; exit 1 }

    python scripts/static_sanity.py
    if ($LASTEXITCODE -ne 0) { Write-Error 'Static HTML sanity failed'; exit 1 }

    python scripts/accessibility_perf_sanity.py
    if ($LASTEXITCODE -ne 0) { Write-Error 'Accessibility/performance sanity failed'; exit 1 }
}
finally {
    Pop-Location
}

exit 0
